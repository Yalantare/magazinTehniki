                                    <TextBlock Text="Лидер продаж" Foreground="#94A3B8" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Width="34" Height="34" Background="#78350F" CornerRadius="17">
                                        <Path Data="M12,18C11.11,18 10.26,17.8 9.5,17.45C11.56,16.5 13,14.42 13,12C13,9.58 11.56,7.5 9.5,6.55C10.26,6.2 11.11,6 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18M20,8.69V4H15.31L12,0.69L8.69,4H4V8.69L0.69,12L4,15.31V20H8.69L12,23.31L15.31,20H20V15.31L23.31,12L20,8.69Z" Fill="Transparent" Stroke="#F59E0B" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Name="CardTopCategoryTxt" Text="Нет данных" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="22" FontWeight="Bold" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Name="CardTopCategoryRevenueTxt" Text="0₽ дохода" Foreground="#94A3B8" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Основной блок аналитики -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.2*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="25" Margin="0,0,20,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Name="ChartTitleTxt" Text="Динамика продаж" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Name="ChartSubtitleTxt" Text="Суммарная выручка по дням" Foreground="#94A3B8" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource ThemePanelBg}" CornerRadius="8" Padding="10,4" BorderBrush="{DynamicResource ThemeBorderLight}" BorderThickness="1">
                                            <TextBlock Name="ChartQuickSummaryTxt" Text="Итого: 0₽" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <Grid>
                                    <!-- Canvas для динамического рендеринга графика с интерактивным наведением -->
                                    <Canvas Name="SalesChartCanvas" 
                                            SizeChanged="SalesChartCanvas_SizeChanged" 
                                            MouseMove="SalesChartCanvas_MouseMove"
                                            MouseLeave="SalesChartCanvas_MouseLeave"
                                            MinHeight="300" 
                                            Background="Transparent"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Распределение по категориям и товарам -->
                        <Border Grid.Column="1" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="16" Padding="25">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Анализ структуры" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="8" Padding="2" BorderBrush="{DynamicResource ThemeBorderLight}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Name="BreakdownTabCatsBtn" Click="BreakdownTab_Click" Tag="Categories" Content="Категории" Background="#2563EB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Padding="8,4" Cursor="Hand" FontSize="12"/>
                                            <Button Name="BreakdownTabProdsBtn" Click="BreakdownTab_Click" Tag="Products" Content="Товары" Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" FontWeight="SemiBold" BorderThickness="0" Padding="8,4" Cursor="Hand" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <StackPanel Name="CategoryStatsPanel" Visibility="Visible">
                                            <!-- Сюда программно добавятся категории с кастомными прогресс-барами -->
                                        </StackPanel>
                                        <StackPanel Name="TopProductsStatsPanel" Visibility="Collapsed">
                                            <!-- Сюда программно добавятся топ товары за выбранный период -->
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        
        <Grid Name="ModalOverlay" Grid.RowSpan="2" Background="#B0050814" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Name="ProductModalBorder" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ThemePanelBg}" CornerRadius="16" Padding="25" BorderBrush="{DynamicResource ThemeBorderLight}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Name="ProductFormColumn" Width="500"/>
                        <ColumnDefinition Name="VariationsColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,25">
                            <TextBlock Name="ModalTitle" Text="Добавить новый продукт" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold"/>
                            <Button Click="CloseModalBtn_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="✕" Foreground="#94A3B8" FontSize="18" FontWeight="Bold"/>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6">
                                        <Run Text="Название"/>
                                        <Run Text=" *" Foreground="#EF4444"/>
                                    </TextBlock>
                                    <TextBlock Name="NameCharCount" Text="0/60" Foreground="#F87171" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="#0F172A" CornerRadius="10" Padding="12,0" Height="40">
                                    <TextBox Name="ModalNameInput" TextChanged="ModalNameInput_TextChanged" MaxLength="60" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6">
                                    <Run Text="Производитель"/>
                                    <Run Text=" *" Foreground="#EF4444"/>
                                </TextBlock>
                                <Border Background="#0F172A" CornerRadius="10" Padding="12,0" Height="40">
                                    <TextBox Name="ModalManufacturerInput" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6">
                                    <Run Text="Категория"/>
                                    <Run Text=" *" Foreground="#EF4444"/>
                                </TextBlock>
                                <Border Background="#0F172A" CornerRadius="10" Padding="5,0" Height="40">
                                    <ComboBox Name="ModalCategoryCombo" DisplayMemberPath="Title" SelectedValuePath="Id" Background="#0F172A" Foreground="Black" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6">
                                    <Run Text="Цена"/>
                                    <Run Text=" *" Foreground="#EF4444"/>
                                </TextBlock>
                                <Border Background="#0F172A" CornerRadius="10" Padding="12,0" Height="40">
                                    <Grid>
                                        <TextBox Name="ModalPriceInput" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="₽" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Количество" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Click="SpinnerMinus_Click" Grid.Column="0" Content="—" Background="#0F172A" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="10,0,0,10"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    
                                    <Border Grid.Column="1" Background="#0F172A" BorderThickness="1,0" BorderBrush="{DynamicResource ThemeBorder}">
                                        <TextBox Name="ModalStockInput" Text="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                    </Border>
                                    
                                    <Button Click="SpinnerPlus_Click" Grid.Column="2" Content="+" Background="#0F172A" Foreground="#94A3B8" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="0,10,10,0"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Ссылка на картинку URL" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                                <Border Background="#0F172A" CornerRadius="10" Padding="12,0" Height="40">
                                    <TextBox Name="ModalImageInput" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,25">
                            <StackPanel>
                                <TextBlock Text="Описание" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,6"/>
                                <Border Background="#0F172A" CornerRadius="10" Padding="12" Height="100">
                                    <TextBox Name="ModalDescInput" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <Button Click="CloseModalBtn_Click" Grid.Column="0" Content="Выйти" Background="{DynamicResource ThemeBorderLight}" Foreground="White" BorderThickness="0" Height="45" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Click="SaveModalProductBtn_Click" Grid.Column="2" Name="ModalSaveBtn" Background="#2563EB" Foreground="White" BorderThickness="0" Height="45" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Name="ModalSaveBtnText" Text="Добавить продукт" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="25,0,0,0" Name="VariationsPanel" Visibility="Collapsed">
                        <TextBlock Text="Вариации товара" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <Border Background="#0F172A" CornerRadius="10" Padding="10" Height="220" BorderBrush="{DynamicResource ThemeBorderLight}" BorderThickness="1">
                            <ListBox Name="VariationsListBox" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="0,5" Width="320">
                                            <DockPanel>
                                                <Button Click="DeleteVariation_Click" Tag="{Binding Id}" DockPanel.Dock="Right" Content="✕" Background="#EF4444" Foreground="White" Width="26" Height="26" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="5,0,0,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Stock, StringFormat={}Остаток: {0} шт.}" Foreground="#64748B" FontSize="10"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="Добавить новую вариацию" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="14" FontWeight="Bold" Margin="0,15,0,10"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Название (например: Черный космос)" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                            <Border Background="#0F172A" CornerRadius="8" Padding="10,0" Height="36">
                                <TextBox Name="VarNameInput" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Цена" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                <Border Background="#0F172A" CornerRadius="8" Padding="10,0" Height="36">
                                    <TextBox Name="VarPriceInput" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Количество" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                <Border Background="#0F172A" CornerRadius="8" Padding="10,0" Height="36">
                                    <TextBox Name="VarStockInput" Text="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" CaretBrush="{DynamicResource ThemeTextPrimary}" BorderThickness="0" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Button Click="AddVariation_Click" Content="Добавить вариацию" Background="#2563EB" Foreground="White" BorderThickness="0" Height="38" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
