<Application x:Class="TehnikiApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TehnikiApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         <SolidColorBrush x:Key="ThemeBg" Color="#0A0E1A" />
         <SolidColorBrush x:Key="ThemeHeaderBg" Color="#050A18" />
         <SolidColorBrush x:Key="ThemeCardBg" Color="#111827" />
         <SolidColorBrush x:Key="ThemePanelBg" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeDarkBg" Color="#0F172A" />
         <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFF" />
         <SolidColorBrush x:Key="ThemeTextSecondary" Color="#94A3B8" />
         <SolidColorBrush x:Key="ThemeTextMuted" Color="#64748B" />
         <SolidColorBrush x:Key="ThemeBorder" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeBorderLight" Color="#334155" />
         <SolidColorBrush x:Key="ThemeAccent" Color="#2563EB" />
         <SolidColorBrush x:Key="ThemeTextBoxBg" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeComboBoxBg" Color="#1E293B" />

         <LinearGradientBrush x:Key="ThemeLoginGradient" EndPoint="0.5,1" StartPoint="0.5,0">
             <GradientStop Color="#0A0E1A" Offset="0" />
             <GradientStop Color="#2563EB" Offset="1" />
         </LinearGradientBrush>

         <Style TargetType="TextBlock">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="TextBox">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="PasswordBox">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="Button">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="CheckBox">
             <Setter Property="FontSize" Value="14"/>
         </Style>
         <Style TargetType="RadioButton">
             <Setter Property="FontSize" Value="14"/>
         </Style>
         <Style TargetType="ComboBox">
             <Setter Property="FontSize" Value="15"/>
         </Style>
    </Application.Resources>
</Application>
