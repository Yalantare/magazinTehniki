<Application x:Class="TehnikiApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TehnikiApp"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
         <SolidColorBrush x:Key="ThemeBg" Color="#0A0E1A" />
         <SolidColorBrush x:Key="ThemeHeaderBg" Color="#050A18" />
         <SolidColorBrush x:Key="ThemeCardBg" Color="#111827" />
         <SolidColorBrush x:Key="ThemePanelBg" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeDarkBg" Color="#0F172A" />
         <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFF" />
         <SolidColorBrush x:Key="ThemeTextSecondary" Color="#94A3B8" />
         <SolidColorBrush x:Key="ThemeTextMuted" Color="#64748B" />
         <SolidColorBrush x:Key="ThemeBorder" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeBorderLight" Color="#475569" />
         <SolidColorBrush x:Key="ThemeAccent" Color="#2563EB" />
         <SolidColorBrush x:Key="ThemeTextBoxBg" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeComboBoxBg" Color="#1E293B" />

         <!-- Status pills dynamic brushes -->
         <SolidColorBrush x:Key="ThemeSuccessBg" Color="#064E3B" />
         <SolidColorBrush x:Key="ThemeSuccessText" Color="#34D399" />
         <SolidColorBrush x:Key="ThemeDangerBg" Color="#7F1D1D" />
         <SolidColorBrush x:Key="ThemeDangerText" Color="#F87171" />
         <SolidColorBrush x:Key="ThemeWarningBg" Color="#3F2D06" />
         <SolidColorBrush x:Key="ThemeWarningText" Color="#F59E0B" />
         <SolidColorBrush x:Key="ThemeInfoBg" Color="#1E3A8A" />
         <SolidColorBrush x:Key="ThemeInfoText" Color="#3B82F6" />
         <SolidColorBrush x:Key="ThemePurpleBg" Color="#311042" />
         <SolidColorBrush x:Key="ThemePurpleText" Color="#A855F7" />
         <SolidColorBrush x:Key="ThemeUserBadgeBg" Color="#1E293B" />
         <SolidColorBrush x:Key="ThemeUserBadgeText" Color="#94A3B8" />

         <LinearGradientBrush x:Key="ThemeLoginGradient" EndPoint="0.5,1" StartPoint="0.5,0">
             <GradientStop Color="#0A0E1A" Offset="0" />
             <GradientStop Color="#2563EB" Offset="1" />
         </LinearGradientBrush>

         <Style TargetType="TextBlock">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="TextBox">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="PasswordBox">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="Button">
             <Setter Property="FontSize" Value="15"/>
         </Style>
         <Style TargetType="CheckBox">
             <Setter Property="FontSize" Value="14"/>
         </Style>
         <Style TargetType="RadioButton">
             <Setter Property="FontSize" Value="14"/>
         </Style>

         <!-- Custom ToggleButton for ComboBox -->
         <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
             <Border x:Name="TemplateRoot"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="8"
                     SnapsToDevicePixels="True">
                 <Border x:Name="SplitBorder"
                         Width="26"
                         HorizontalAlignment="Right"
                         BorderThickness="0"
                         Background="Transparent"
                         SnapsToDevicePixels="True">
                     <Path x:Name="Arrow"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Data="M 0 0 L 4.5 4.5 L 9 0 Z"
                           Fill="{DynamicResource ThemeTextSecondary}" />
                 </Border>
             </Border>
             <ControlTemplate.Triggers>
                 <Trigger Property="IsMouseOver" Value="True">
                     <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeTextPrimary}" />
                 </Trigger>
                 <Trigger Property="IsEnabled" Value="False">
                     <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeTextMuted}" />
                     <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.6" />
                 </Trigger>
             </ControlTemplate.Triggers>
         </ControlTemplate>

         <!-- Dark / Adaptive ComboBox Style -->
         <Style TargetType="ComboBox">
             <Setter Property="FontSize" Value="14"/>
             <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
             <Setter Property="Background" Value="{DynamicResource ThemeComboBoxBg}"/>
             <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
             <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
             <Setter Property="Padding" Value="10,6"/>
             <Setter Property="SnapsToDevicePixels" Value="True"/>
             <Setter Property="Template">
                 <Setter.Value>
                     <ControlTemplate TargetType="ComboBox">
                         <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                             <Popup x:Name="PART_Popup"
                                    AllowsTransparency="True"
                                    Placement="Bottom"
                                    IsOpen="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    PopupAnimation="Slide">
                                 <Border x:Name="DropDownBorder"
                                         Background="{DynamicResource ThemeCardBg}"
                                         BorderBrush="{DynamicResource ThemeBorder}"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Margin="0,4,0,0"
                                         MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                         MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                         SnapsToDevicePixels="True">
                                     <ScrollViewer x:Name="DropDownScrollViewer" Margin="2,4" SnapsToDevicePixels="True">
                                         <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                     </ScrollViewer>
                                 </Border>
                             </Popup>
                             <ToggleButton Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                           Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                           Focusable="False"
                                           ClickMode="Press" />
                             <ContentPresenter Margin="{TemplateBinding Padding}"
                                               IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                             <TextBox x:Name="PART_EditableTextBox"
                                      Margin="{TemplateBinding Padding}"
                                      Background="Transparent"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderThickness="0"
                                      IsReadOnly="{TemplateBinding IsReadOnly}"
                                      Visibility="Hidden"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                         </Grid>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsEditable" Value="True">
                                 <Setter Property="IsTabStop" Value="False" />
                                 <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                             </Trigger>
                         </ControlTemplate.Triggers>
                     </ControlTemplate>
                 </Setter.Value>
             </Setter>
         </Style>

         <!-- Custom ComboBoxItem Style -->
         <Style TargetType="ComboBoxItem">
             <Setter Property="SnapsToDevicePixels" Value="True"/>
             <Setter Property="Padding" Value="10,8"/>
             <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="Template">
                 <Setter.Value>
                     <ControlTemplate TargetType="ComboBoxItem">
                         <Border x:Name="ItemBorder"
                                 Background="{TemplateBinding Background}"
                                 BorderThickness="0"
                                 CornerRadius="6"
                                 Margin="2,1"
                                 Padding="{TemplateBinding Padding}"
                                 SnapsToDevicePixels="True">
                             <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                         </Border>
                         <ControlTemplate.Triggers>
                             <Trigger Property="IsMouseOver" Value="True">
                                 <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeBorderLight}"/>
                             </Trigger>
                             <Trigger Property="IsSelected" Value="True">
                                 <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                 <Setter Property="Foreground" Value="#FFFFFF"/>
                             </Trigger>
                         </ControlTemplate.Triggers>
                     </ControlTemplate>
                 </Setter.Value>
             </Setter>
         </Style>

         <!-- Custom DatePickerTextBox & DatePicker Style -->
         <Style TargetType="{x:Type primitives:DatePickerTextBox}">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
             <Setter Property="BorderThickness" Value="0"/>
             <Setter Property="VerticalContentAlignment" Value="Center"/>
             <Setter Property="SelectionBrush" Value="{DynamicResource ThemeAccent}"/>
             <Setter Property="Template">
                 <Setter.Value>
                     <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                         <Grid>
                             <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
                                 <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                             </Border>
                         </Grid>
                     </ControlTemplate>
                 </Setter.Value>
             </Setter>
         </Style>

         <Style TargetType="DatePicker">
             <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="BorderThickness" Value="0"/>
             <Setter Property="FontSize" Value="13"/>
         </Style>
    </Application.Resources>
</Application>
