# ========================================================
# Конфигурация проекта Магазин Техники (magazinTehniki)
# ========================================================

# Настройки подключения к базе данных MySQL с хоста (вашего ПК)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=shop
DB_USER=root
DB_PASSWORD=root

# Внешний порт Docker для MySQL (3307 вместо 3306 во избежание конфликта с локальной службой MySQL на Windows)
DB_EXTERNAL_PORT=3307

# Порт бэкенд-сервера
SERVER_PORT=8090
